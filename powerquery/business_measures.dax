/*
Project: Coffee Shop Sales Analytics
Description: Advanced DAX measures for financial performance tracking and MoM growth.
*/

-- Basic Aggregations
Total Sales = SUM(Transactions[Sales])
Total Orders = DISTINCTCOUNT(Transactions[transaction_id])
Total Qty Sold = SUM(Transactions[transaction_qty])

-- Time Intelligence: Current Month (CM)
CM Sales = 
VAR selected_month = SELECTEDVALUE('Date Table'[Month])
RETURN
TOTALMTD(CALCULATE([Total Sales], 'Date Table'[Month] = selected_month), 'Date Table'[Date])

-- Time Intelligence: Previous Month (PM)
PM Sales = CALCULATE([CM Sales], DATEADD('Date Table'[Date], -1, MONTH))

-- Advanced KPI: MoM Growth with dynamic formatting
MoM growth & Diff Sales = 
    VAR mom_diff = [CM Sales] - [PM Sales]
    VAR mom_growth = DIVIDE(mom_diff, [PM Sales])
    VAR g_sign = IF(mom_diff > 0, "+", "")
    VAR s_trend = IF(mom_diff > 0, "▲", "▼")
    RETURN
    s_trend & " " & g_sign & FORMAT(mom_growth, "#0.0%") & " │ " & g_sign & FORMAT(mom_diff/1000, "0.0K") & " vs LM"

-- Average Daily Sales for Performance Benchmarking
Daily Avg Sales = AVERAGEX(ALLSELECTED(Transactions[transaction_date]), [Total Sales])

-- Conditional Formatting for Visuals
Colour for Columns = IF([Total Sales] > [Daily Avg Sales], "Above Average", "Below Average")
